// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // "user" or "admin"
  accounts      Account[]
  sessions      Session[]
  checklistItems ChecklistItem[]
  routines      Routine[]
  projects      Project[]
  tasks         Task[]
  trackers      Tracker[]
  schoolSubjects SchoolSubject[]
  analyticsEvents AnalyticsEvent[]
  userSessions   UserSession[]
  dailyAnalytics DailyAnalytics[]
  conversations  Conversation[]
  aiConversations AIConversation[]
  businessClients BusinessClient[]
  businessContentIdeas BusinessContentIdea[]
  books Book[]
  gratitudes Gratitude[]
  goals Goal[]
  clients Client[]
  subjects Subject[]
  activityHistories ActivityHistory[]
  fitnessEntries FitnessEntry[]
  workoutEntries WorkoutEntry[]
  courses Course[]
  grades Grade[]
  focusSessions FocusSession[]
  deals Deal[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  Json     // Store all user settings as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  priority  String   // 'low' | 'medium' | 'high'
  source    String   @default("manual") // 'manual' | 'routine' | 'project' | 'school'
  sourceId  String?  // ID of source item (routineId, projectId, etc.)
  dueDate   DateTime? // For sorting and filtering by date
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("checklist_items")
}

model Routine {
  id          String   @id @default(cuid())
  name        String
  description String
  timeOfDay   String   // 'morning' | 'afternoon' | 'evening' | 'anytime'
  duration    Int
  isActive    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       RoutineTask[]
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("routines")
}

model RoutineTask {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("routine_tasks")
}

model Project {
  id        String   @id @default(cuid())
  title     String
  description String
  status    String   // 'not-started' | 'in-progress' | 'completed'
  priority  String   // 'low' | 'medium' | 'high'
  startDate String?
  dueDate   String?
  progress  Float    @default(0)
  tags      String   // JSON array
  notes     String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks  Subtask[]
  tasks     Task[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("projects")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  dueDate   DateTime? // For showing in Today view
  priority  String?   // Inherited from project or custom
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("subtasks")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  status    String   // 'todo' | 'in-progress' | 'done'
  priority  String   // 'low' | 'medium' | 'high'
  dueDate   String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags      String   // JSON array
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItems ChecklistItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tasks")
}

model Tracker {
  id        String   @id @default(cuid())
  name      String
  type      String   // 'habit' | 'metric'
  unit      String
  goal      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   TrackerEntry[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("trackers")
}

model TrackerEntry {
  id        String   @id @default(cuid())
  date      String
  value     Float
  trackerId String
  tracker   Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tracker_entries")
}

model SchoolSubject {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    SchoolEvent[]
  grades    SchoolGrade[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("school_subjects")
}

model SchoolEvent {
  id        String   @id @default(cuid())
  title     String
  date      String
  type      String   // e.g., 'exam', 'assignment'
  completed Boolean  @default(false)
  subjectId String
  subject   SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("school_events")
}

model SchoolGrade {
  id        String   @id @default(cuid())
  period    String
  grade     Float
  subjectId String
  subject   SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("school_grades")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  eventData String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_events")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  modulesUsed String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // in seconds
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model DailyAnalytics {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  totalTime         Int      @default(0)
  modulesUsed       String   // JSON array of modules
  completions       Int      @default(0)
  productivityScore Float    @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_analytics")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  attachments Attachment[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String      // 'user' or 'assistant'
  content        String
  createdAt      DateTime    @default(now())

  attachments Attachment[]
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id             String      @id @default(cuid())
  name           String
  type           String      // MIME type
  size           Int         // Size in bytes
  url            String
  metadata       Json?       // Additional metadata as JSON
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("attachments")
}

model BusinessClient {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   // 'lead' | 'prospect' | 'active' | 'inactive'
  source      String?  // 'referral' | 'website' | 'social' | 'cold' | 'other'
  projects    Int      @default(0)
  totalRevenue Float   @default(0)
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@index([userId])
  @@map("business_clients")
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Float    // deal value in dollars
  stage       String   // 'lead' | 'qualified' | 'proposal' | 'negotiation' | 'won' | 'lost'
  probability Int      @default(50) // 0-100 percent
  expectedClose DateTime?
  notes       String?
  clientId    String
  client      BusinessClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
  @@map("deals")
}

model BusinessContentIdea {
  id        String   @id @default(cuid())
  title     String
  platform  String
  status    String   // 'draft' | 'scheduled' | 'published'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("business_content_ideas")
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String?
  status    String   // 'read' | 'reading' | 'to-read'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("books")
}

model Gratitude {
  id        String   @id @default(cuid())
  content   String
  date      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("gratitudes")
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   // 'active' | 'completed' | 'paused'
  deadline    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("goals")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  status    String   // 'active' | 'inactive'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("clients")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("subjects")
}

model ActivityHistory {
  id        String   @id @default(cuid())
  activity  String
  date      String
  duration  Int?     // in minutes
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("activity_history")
}

model FitnessEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  steps     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("fitness_entries")
}

model WorkoutEntry {
  id              String   @id @default(cuid())
  userId          String
  name            String   // "Running", "Yoga", "Weightlifting", etc.
  durationMinutes Int
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("workout_entries")
}

// School Module - Advanced GPA tracking
model Course {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String
  credits     Float
  semester    String   // e.g., "Fall 2024", "Spring 2025"
  year        Int
  professor   String?
  color       String   @default("#3b82f6")
  finalGrade  Float?   // Calculated final grade percentage
  letterGrade String?  // Calculated letter grade (A, B+, etc.)
  grades      Grade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([userId, semester, year])
  @@map("courses")
}

model Grade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Midterm", "Final", "Assignment 1"
  score       Float    // actual score
  maxScore    Float    // maximum possible score
  weight      Float    // percentage weight (0-100)
  category    String   // "Exam", "Assignment", "Quiz", "Project", "Participation"
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([courseId])
  @@index([userId])
  @@map("grades")
}

model FocusSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Session info
  startTime      DateTime
  endTime        DateTime?
  duration       Int      // planned duration in minutes
  actualDuration Int?     // actual duration if stopped early
  
  // Session type
  sessionType    String   // 'work' | 'break'
  
  // Task association
  taskId         String?
  taskSource     String?  // 'project' | 'checklist' | 'routine' | 'manual'
  taskTitle      String?  // snapshot of task title
  
  // Tracking
  completed      Boolean  @default(false)
  interrupted    Boolean  @default(false)
  interruptions  Int      @default(0)
  focusQuality   Int?     // 1-5 rating
  notes          String?
  
  createdAt      DateTime @default(now())
  
  @@index([userId])
  @@index([userId, startTime])
  @@map("focus_sessions")
}

