// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  isPublic      Boolean   @default(true)
  password      String?
  role          String    @default("user") // "user" or "admin"
  accounts      Account[]
  sessions      Session[]
  checklistItems ChecklistItem[]
  routines      Routine[]
  projects      Project[]
  tasks         Task[]
  trackers      Tracker[]
  analyticsEvents AnalyticsEvent[]
  userSessions   UserSession[]
  dailyAnalytics DailyAnalytics[]
  cognitiveSnapshot UserCognitiveSnapshot?
  insights       Insight[]
  conversations  Conversation[]
  aiConversations AIConversation[]
  businessClients BusinessClient[]
  businessContentIdeas BusinessContentIdea[]
  books Book[]
  gratitudes Gratitude[]
  goals Goal[]
  clients Client[]
  subjects Subject[]
  activityHistories ActivityHistory[]
  fitnessEntries FitnessEntry[]
  workoutEntries WorkoutEntry[]
  courses Course[]
  grades Grade[]
  focusSessions FocusSession[]
  deals Deal[]
  templates Template[]
  quickNotes QuickNote[]
  timeBlocks TimeBlock[]
  cognitiveTwinRecord CognitiveTwinRecord?

  // Social
  // Social
  sentMessages     DirectMessage[]  @relation("SentMessages")
  receivedMessages DirectMessage[]  @relation("ReceivedMessages")
  
  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")

  // AI Chat
  aiChats       ChatSession[]

  // Music
  likedTracks     LikedTrack[]
  musicPlaylists  MusicPlaylist[]
  musicHistory    MusicHistory[]
  followedArtists MusicArtist[]

  // External Integrations (Notion, Drive, etc.)
  integrationAccounts IntegrationAccount[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  theme           String  @default("system")
  language        String  @default("en")
  notifications   Boolean @default(true)
  soundEnabled    Boolean @default(true)
  compactMode     Boolean @default(false)
  showAnimations  Boolean @default(true)
  
  // JSON for flexible preferences (widget positions, etc.)
  preferences     String  @default("{}") 

  settings  Json     // Store all user settings as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  priority  String   // 'low' | 'medium' | 'high'
  source    String   @default("manual") // 'manual' | 'routine' | 'project' | 'school'
  sourceId  String?  // ID of source item (routineId, projectId, etc.)
  dueDate   DateTime? // For sorting and filtering by date
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("checklist_items")
}

model Routine {
  id            String   @id @default(cuid())
  name          String
  description   String
  timeOfDay     String   // 'morning' | 'afternoon' | 'evening' | 'anytime'
  duration      Int
  isActive      Boolean  @default(true)
  scheduledTime String?  // HH:MM format for scheduled time
  daysOfWeek    String?  // JSON array of days e.g. ["monday", "wednesday", "friday"]
  
  // New structured fields
  objective     String?
  frequency     String? // e.g. "3 days/week"
  level         String? // e.g. "Beginner"
  tempo         String? // e.g. "3-0-1"
  method        String? // e.g. "Drop sets"
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relations
  days          RoutineDay[]
  logs          WorkoutLog[]
  timeBlocks    TimeBlock[]
  
  // Legacy support (optional)
  tasks         RoutineTask[]
  completions   RoutineCompletion[]
  
  updatedAt     DateTime @updatedAt
  version       Int      @default(1)

  @@map("routines")
}

model RoutineDay {
  id        String @id @default(cuid())
  name      String // e.g. "Day 1 - Push"
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  order     Int    @default(0)
  weekday   String? // 'monday', 'tuesday', etc.

  @@map("routine_days")
}

model RoutineExercise {
  id           String @id @default(cuid())
  name         String
  muscleGroup  String // e.g. "Chest" (Frontend will enforce Enum)
  sets         Int
  reps         String // e.g. "10-12" or "30s"
  tempo        String? // e.g. "3-1-1" or "3s down"
  notes        String?
  dayId        String
  day          RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order        Int    @default(0)

  @@map("routine_exercises")
}

model WorkoutLog {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  duration  Int      // seconds
  completed Boolean  @default(false)
  exercises WorkoutExerciseLog[]

  @@map("workout_logs")
}

model WorkoutExerciseLog {
  id            String @id @default(cuid())
  workoutLogId  String
  workoutLog    WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseName  String
  muscleGroup   String?
  setsDone      Int
  repsDone      String? // Optional, if they want to log specific reps
  weight        Float?  // Optional, for progression
  notes         String?

  @@map("workout_exercise_logs")
}

// Legacy models kept for backward compatibility if needed
model RoutineTask {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("routine_tasks")
}

model RoutineCompletion {
  id          String   @id @default(cuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  scheduledDay String?  // e.g. 'monday'
  tasksTotal  Int
  tasksCompleted Int

  @@map("routine_completions")
}

model Project {
  id        String   @id @default(cuid())
  title     String
  description String
  status    String   // 'not-started' | 'in-progress' | 'completed'
  priority  String   // 'low' | 'medium' | 'high'
  startDate String?
  dueDate   String?
  progress  Float    @default(0)
  tags      String   // JSON array
  notes     String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks  Subtask[]
  tasks     Task[]
  timeBlocks TimeBlock[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("projects")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  dueDate   DateTime? // For showing in Today view
  priority  String?   // Inherited from project or custom
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("subtasks")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  status    String   // 'todo' | 'in-progress' | 'done'
  priority  String   // 'low' | 'medium' | 'high'
  dueDate   String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags      String   // JSON array
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItems ChecklistItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tasks")
}

model Tracker {
  id        String   @id @default(cuid())
  name      String
  type      String   // 'habit' | 'metric'
  unit      String
  goal      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   TrackerEntry[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("trackers")
}

model TrackerEntry {
  id        String   @id @default(cuid())
  date      String
  value     Float
  trackerId String
  tracker   Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tracker_entries")
}



model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  eventData String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_events")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  modulesUsed String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // in seconds
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model DailyAnalytics {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  totalTime         Int      @default(0)
  modulesUsed       String   // JSON array of modules
  completions       Int      @default(0)
  productivityScore Float    @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_analytics")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  attachments Attachment[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String      // 'user' or 'assistant'
  content        String
  createdAt      DateTime    @default(now())

  attachments Attachment[]
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id             String      @id @default(cuid())
  name           String
  type           String      // MIME type
  size           Int         // Size in bytes
  url            String
  metadata       Json?       // Additional metadata as JSON
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("attachments")
}

model BusinessClient {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   // 'lead' | 'prospect' | 'active' | 'inactive'
  source      String?  // 'referral' | 'website' | 'social' | 'cold' | 'other'
  projects    Int      @default(0)
  totalRevenue Float   @default(0)
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@index([userId])
  @@map("business_clients")
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Float    // deal value in dollars
  stage       String   // 'lead' | 'qualified' | 'proposal' | 'negotiation' | 'won' | 'lost'
  probability Int      @default(50) // 0-100 percent
  expectedClose DateTime?
  notes       String?
  clientId    String
  client      BusinessClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
  @@map("deals")
}

model BusinessContentIdea {
  id        String   @id @default(cuid())
  title     String
  platform  String
  status    String   // 'draft' | 'scheduled' | 'published'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("business_content_ideas")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  coverUrl    String?
  totalPages  Int?
  currentPage Int      @default(0)
  status      String   // 'read' | 'reading' | 'to-read'
  rating      Int?     // 1-5
  review      String?  // Text review
  notes       String?  // General notes
  pageNotes   Json?    // Array of { page: Int, note: String, date: DateTime }
  isbn        String?
  genre       String?  // Primary genre/subject
  categories  String?  // Comma-separated categories
  description String?  // Book description/synopsis
  format      String   @default("digital") // 'digital' | 'physical' | 'audiobook'
  startedAt   DateTime?
  finishedAt  DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("books")
}

model Gratitude {
  id        String   @id @default(cuid())
  content   String
  date      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("gratitudes")
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   // 'active' | 'completed' | 'paused'
  timeframe   String   @default("year") // 'year' | 'quarter' | 'month'
  deadline    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Float    @default(0)
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("goals")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  status    String   // 'active' | 'inactive'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("clients")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("subjects")
}

model ActivityHistory {
  id        String   @id @default(cuid())
  activity  String
  date      String
  duration  Int?     // in minutes
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("activity_history")
}

model FitnessEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  steps     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("fitness_entries")
}

model WorkoutEntry {
  id              String   @id @default(cuid())
  userId          String
  name            String   // "Running", "Yoga", "Weightlifting", etc.
  durationMinutes Int
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("workout_entries")
}

// School Module - Advanced GPA tracking
model Course {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  credits     Float?
  semester    String   // e.g., "Fall 2024", "Spring 2025"
  year        Int
  professor   String?
  color       String   @default("#3b82f6")
  educationType String @default("university")
  finalGrade  Float?   // Calculated final grade percentage
  letterGrade String?  // Calculated letter grade (A, B+, etc.)
  grades      Grade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([userId, semester, year])
  @@map("courses")
}

model Grade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Midterm", "Final", "Assignment 1"
  score       Float    // actual score
  maxScore    Float    // maximum possible score
  weight      Float    // percentage weight (0-100)
  category    String   // "Exam", "Assignment", "Quiz", "Project", "Participation"
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([courseId])
  @@index([userId])
  @@map("grades")
}

model FocusSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Session info
  startTime      DateTime
  endTime        DateTime?
  duration       Int      // planned duration in minutes
  actualDuration Int?     // actual duration if stopped early
  
  // Session type
  sessionType    String   // 'work' | 'break'
  
  // Task association
  taskId         String?
  taskSource     String?  // 'project' | 'checklist' | 'routine' | 'manual'
  taskTitle      String?  // snapshot of task title
  
  // Tracking
  completed      Boolean  @default(false)
  interrupted    Boolean  @default(false)
  interruptions  Int      @default(0)
  focusQuality   Int?     // 1-5 rating
  notes          String?
  
  createdAt      DateTime @default(now())
  
  @@index([userId])
  @@index([userId, startTime])
  @@map("focus_sessions")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // 'routine' | 'project' | 'checklist'
  category    String?  // 'productivity' | 'health' | 'business' | 'personal' | 'custom'
  content     Json     // Stores the template data structure
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isPublic])
  @@map("templates")
}

model QuickNote {
  id          String   @id @default(cuid())
  content     String
  type        String   @default("note") // 'note' | 'idea' | 'task' | 'reminder'
  tags        String[] // Array of tag strings
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  color       String?  // Optional color for the note
  convertedTo String?  // If converted to task/project, store the ID
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isPinned])
  @@map("quick_notes")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   // 'PENDING' | 'ACCEPTED' | 'REJECTED'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String
  messages  String   // JSON string of messages
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

model UserCognitiveSnapshot {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusTimeToday         Int       @default(0) // in minutes
  productivityScore      Float     @default(0) // 0-10 or 0-100 scale
  fatigueEstimate        String    @default("low") // 'low' | 'medium' | 'high'
  overdueTasks           Int       @default(0)
  lastInsightGeneratedAt DateTime?
  updatedAt              DateTime  @updatedAt

  @@index([updatedAt])
  @@map("user_cognitive_snapshots")
}

model Insight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  type      String   // e.g., 'fatigue', 'productivity', 'habit'
  status    String   @default("unread") // 'unread', 'read', 'archived'
  createdAt DateTime @default(now())

  @@index([userId, status])
  @@map("insights")
}

model LikedTrack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   // YTMusic track ID
  title     String
  artist    String
  artistId  String?
  album     String?
  thumbnail String?
  duration  Int?
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@map("music_liked_tracks")
}

model MusicHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String   // YTMusic track ID
  title     String
  artist    String
  artistId  String?
  thumbnail String?
  playedAt  DateTime @default(now())

  @@index([userId, playedAt])
  @@map("music_history")
}

model MusicPlaylist {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      Json     // JSON array of tracks for simplicity metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("music_playlists")
}

model MusicArtist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String   // YTMusic artist channel ID
  name      String
  imageUrl  String?
  followedAt DateTime @default(now())

  @@unique([userId, artistId])
  @@map("music_followed_artists")
}

model TimeBlock {
  id             String   @id @default(uuid())
  title          String
  type           String   // 'task' | 'project_deadline' | 'google_event' | 'cognitive_rest'
  startTime      DateTime
  endTime        DateTime
  googleEventId  String?  @unique
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  routineId      String?
  routine        Routine? @relation(fields: [routineId], references: [id], onDelete: SetNull)
  energyRequired String   @default("medium") // 'high' | 'medium' | 'low'
  status         String   @default("pending") // 'pending' | 'completed'
  
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([googleEventId])
  @@index([userId])
  @@map("time_blocks")
}

// ─── Cognitive Twin Evolution Models ─────────────────────────────────────────

model CognitiveTwinRecord {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  confidenceScore  Float    @default(42)
  trustLevel       String   @default("initial") // 'initial' | 'learning' | 'adapted' | 'validated'
  isInitialized    Boolean  @default(false)
  onboardingCompletedAt DateTime?              // Set once when onboarding finishes; never mutated by Evolution Engine

  // Serialized JSON blobs — mirrors CognitiveTwin TypeScript interface
  identity         Json     @default("{}")
  energyCurve      Json     @default("{}")
  metrics          Json     @default("{}")
  bottlenecks      Json     @default("{}")
  workspaceLayout  Json     @default("{}")

  totalSignals     Int      @default(0) // running count, used for confidence math

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  signals          BehavioralSignal[]
  evolutionLog     TwinEvolutionLog[]
  snapshots        TwinSnapshot[]

  @@map("cognitive_twin_records")
}

model BehavioralSignal {
  id         String   @id @default(cuid())
  userId     String
  twinId     String
  twin       CognitiveTwinRecord @relation(fields: [twinId], references: [id], onDelete: Cascade)

  // Signal type
  signal     String   // 'task_created' | 'task_completed' | 'task_deferred' |
                      // 'focus_started' | 'focus_finished' | 'routine_completed' | 'routine_skipped'

  // Rich metadata (all optional)
  hour       Int?     // Hour of day 0-23 — chronotype inference
  duration   Int?     // Minutes — focus session length
  quality    Int?     // 1-5 — focus quality rating
  metadata   Json?    // Arbitrary extra data

  occurredAt DateTime @default(now())

  @@index([userId, signal])
  @@index([userId, occurredAt])
  @@index([twinId, occurredAt])
  @@map("behavioral_signals")
}

model TwinEvolutionLog {
  id          String   @id @default(cuid())
  twinId      String
  twin        CognitiveTwinRecord @relation(fields: [twinId], references: [id], onDelete: Cascade)
  userId      String

  changeType  String   // 'confidence_increase' | 'chronotype_updated' | 'peak_window_detected' |
                       // 'friction_detected' | 'burnout_risk_raised' | 'trust_level_up' | etc.
  description String   // Human-readable: "Morning lark pattern detected over 14 days"
  prevValue   String?  // JSON string of old value
  newValue    String?  // JSON string of new value

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([twinId, createdAt])
  @@map("twin_evolution_logs")
}

model TwinSnapshot {
  id               String   @id @default(cuid())
  twinId           String
  twin             CognitiveTwinRecord @relation(fields: [twinId], references: [id], onDelete: Cascade)
  userId           String

  // Key metrics snapshot — for trend graphs and visualizations
  confidenceScore  Float
  trustLevel       String
  cognitiveLoad    Float
  burnoutIndex     Float
  chronotype       String   // '' | 'morning_lark' | 'night_owl' | 'afternoon_peak'
  mainFrictionPoint String  // '' | 'procrastination' | 'context_switching' | etc.
  peakFocusStart   String   // e.g. '09:00'
  peakFocusEnd     String   // e.g. '12:00'
  totalSignals     Int

  snapshotDate     DateTime @default(now())

  @@unique([twinId, snapshotDate]) // one snapshot per day
  @@index([userId, snapshotDate])
  @@map("twin_snapshots")
}

// ── External Service Integration Tokens ─────────────────────────────────────
// Stores OAuth credentials for third-party services (Notion, Google Drive, etc.)
// Kept separate from NextAuth Account model to avoid schema coupling.
model IntegrationAccount {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // "notion" | "drive"
  accessToken   String
  refreshToken  String?
  tokenType     String?
  scope         String?
  expiresAt     DateTime?
  // Provider-specific metadata (workspaceId, botId, selectedDatabaseIds, etc.)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("integration_accounts")
}
