// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // "user" or "admin"
  kiloUserId    String?
  accounts      Account[]
  sessions      Session[]
  checklistItems ChecklistItem[]
  routines      Routine[]
  projects      Project[]
  tasks         Task[]
  trackers      Tracker[]
  schoolSubjects SchoolSubject[]
  analyticsEvents AnalyticsEvent[]
  userSessions   UserSession[]
  dailyAnalytics DailyAnalytics[]
  conversations  Conversation[]
  aiConversations AIConversation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  priority  String   // 'low' | 'medium' | 'high'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("checklist_items")
}

model Routine {
  id          String   @id @default(cuid())
  name        String
  description String
  timeOfDay   String   // 'morning' | 'afternoon' | 'evening' | 'anytime'
  duration    Int
  isActive    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       RoutineTask[]
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@map("routines")
}

model RoutineTask {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("routine_tasks")
}

model Project {
  id        String   @id @default(cuid())
  title     String
  description String
  status    String   // 'not-started' | 'in-progress' | 'completed'
  priority  String   // 'low' | 'medium' | 'high'
  startDate String?
  dueDate   String?
  progress  Float    @default(0)
  tags      String   // JSON array
  notes     String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks  Subtask[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("projects")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("subtasks")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  status    String   // 'todo' | 'in-progress' | 'done'
  priority  String   // 'low' | 'medium' | 'high'
  dueDate   String?
  projectId String?
  tags      String   // JSON array
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tasks")
}

model Tracker {
  id        String   @id @default(cuid())
  name      String
  type      String   // 'habit' | 'metric'
  unit      String
  goal      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   TrackerEntry[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("trackers")
}

model TrackerEntry {
  id        String   @id @default(cuid())
  date      String
  value     Float
  trackerId String
  tracker   Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("tracker_entries")
}

model SchoolSubject {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    SchoolEvent[]
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("school_subjects")
}

model SchoolEvent {
  id        String   @id @default(cuid())
  title     String
  date      String
  type      String   // e.g., 'exam', 'assignment'
  completed Boolean  @default(false)
  subjectId String
  subject   SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@map("school_events")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  eventData String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_events")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  modulesUsed String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // in seconds
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model DailyAnalytics {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  totalTime         Int      @default(0)
  modulesUsed       String   // JSON array of modules
  completions       Int      @default(0)
  productivityScore Float    @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_analytics")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  attachments Attachment[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String      // 'user' or 'assistant'
  content        String
  createdAt      DateTime    @default(now())

  attachments Attachment[]
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id             String      @id @default(cuid())
  name           String
  type           String      // MIME type
  size           Int         // Size in bytes
  url            String
  metadata       Json?       // Additional metadata as JSON
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("attachments")
}
