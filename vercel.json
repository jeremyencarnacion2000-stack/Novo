{
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run vercel-build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/daily-insights",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/reengagement",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/ambient-context",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/activity-retention",
      "schedule": "0 2 * * *"
    }
  ]
}
