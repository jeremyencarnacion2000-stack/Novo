# ─── Auth ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── Google (OAuth + Calendar) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Spotify ─────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── GitHub (OAuth connector + aggregate coding context) ─────────────────────
# Register https://your-domain.vercel.app/api/integration/github/callback as the
# callback URL. Keep the secret server-side; Novo never sends it to the client.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ─── AI Providers (model orchestra) ──────────────────────────────────────────
# Gemini — real-time context reasoning + Gemini Live (REQUIRED)
GEMINI_API_KEY=

# Groq — ultra-fast inference, primary stream model (REQUIRED)
GROQ_API_KEY=

# OpenRouter — model routing fallback: Qwen, Claude, Gemini via one key (REQUIRED)
OPENROUTER_API_KEY=

# Grok/xAI — social-context and real-time web intelligence (optional)
XAI_API_KEY=
GROK_API_KEY=

# ─── Background jobs (Inngest) ────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Real-time SSE push ───────────────────────────────────────────────────────
# Shared secret between Inngest jobs and the /api/events/push endpoint.
# Generate with: openssl rand -base64 32
EVENTS_WEBHOOK_SECRET=

# ─── Stripe (Pro subscription billing) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
