# ─── Auth ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/novo

# ─── Google (OAuth + Calendar) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Spotify ─────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── AI Providers (model orchestra) ──────────────────────────────────────────
# Gemini — real-time context reasoning + Gemini Live (REQUIRED)
GEMINI_API_KEY=AIzaSy...

# Groq — ultra-fast inference, primary stream model (REQUIRED)
GROQ_API_KEY=gsk_...

# OpenRouter — model routing fallback: Qwen, Claude, Gemini via one key (REQUIRED)
OPENROUTER_API_KEY=sk-or-v1-...

# Grok/xAI — social-context and real-time web intelligence (optional)
XAI_API_KEY=xai-...
GROK_API_KEY=your-grok-api-key-here

# ─── Background jobs (Inngest) ────────────────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ─── Real-time SSE push ───────────────────────────────────────────────────────
# Shared secret between Inngest jobs and the /api/events/push endpoint.
# Generate with: openssl rand -base64 32
EVENTS_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32

# ─── Stripe (Pro subscription billing) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
